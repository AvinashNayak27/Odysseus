{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odysseus.local/config/v1",
  "type": "object",
  "required": ["schemaVersion", "workspace", "yukon", "selection", "research", "experiments", "candidate_provider", "reporting"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "workspace": {"type": "object", "additionalProperties": false, "required": ["state_root", "clone_root", "artifact_retention_days", "max_output_bytes"], "properties": {"state_root": {"type": "string", "minLength": 1}, "clone_root": {"type": "string", "minLength": 1}, "artifact_retention_days": {"type": "integer", "minimum": 1}, "max_output_bytes": {"type": "integer", "minimum": 1024}}},
    "yukon": {"type": "object", "additionalProperties": false, "required": ["binary", "api_url_env", "read_retries", "setup_timeout_seconds", "run_timeout_seconds"], "properties": {"binary": {"type": "string", "minLength": 1}, "api_url_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "read_retries": {"type": "integer", "minimum": 0, "maximum": 5}, "setup_timeout_seconds": {"type": "integer", "minimum": 1}, "run_timeout_seconds": {"type": "integer", "minimum": 1}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["active_window_days", "supported_objectives"], "properties": {"active_window_days": {"type": "integer", "minimum": 1}, "supported_objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "research": {"type": "object", "additionalProperties": false, "required": ["allowed_domains", "max_sources_per_query"], "properties": {"allowed_domains": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}}, "max_sources_per_query": {"type": "integer", "minimum": 1}}},
    "experiments": {"type": "object", "additionalProperties": false, "required": ["pilot_samples", "min_repetitions", "max_repetitions"], "properties": {"pilot_samples": {"const": 3}, "min_repetitions": {"type": "integer", "minimum": 5}, "max_repetitions": {"type": "integer", "minimum": 5}}},
    "candidate_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timeout_seconds", "max_request_bytes", "max_candidates", "max_response_bytes"],
      "properties": {
        "mode": {"enum": ["human-import", "external-cli", "reference"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "base_url": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"},
        "public_model": {"type": "string", "minLength": 1},
        "api_model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "secret_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_request_bytes": {"type": "integer", "minimum": 1024},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_response_bytes": {"type": "integer", "minimum": 1024}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "external-cli"}}}, "then": {"required": ["argv"]}},
        {"if": {"properties": {"mode": {"const": "reference"}}}, "then": {"required": ["base_url", "public_model", "api_model", "effort", "secret_env"]}}
      ]
    },
    "reporting": {"type": "object", "additionalProperties": false, "required": ["private_path_aliases", "note_min_bytes", "note_max_bytes"], "properties": {"private_path_aliases": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^\\$[A-Z0-9_]+$"}}, "note_min_bytes": {"type": "integer", "minimum": 5120, "maximum": 102400}, "note_max_bytes": {"type": "integer", "minimum": 5120, "maximum": 102400}}}
  },
  "allOf": [{"properties": {"reporting": {"properties": {"note_min_bytes": {"type": "integer"}, "note_max_bytes": {"type": "integer"}}}}}],
  "not": {"anyOf": [{"required": ["token"]}, {"required": ["api_token"]}, {"required": ["YUKON_API_TOKEN"]}]}
}
